{
    "name": "Mahwous - إضافة منتجات جديدة لسلة",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "استقبال منتجات جديدة"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": {
                "array": "{{1.data}}"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {},
                "parameters": []
            }
        },
        {
            "id": 3,
            "module": "salla:CreateProduct",
            "version": 1,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "name": "{{2.`أسم المنتج`}}",
                "price": "{{2.`سعر المنتج`}}",
                "product_type": "product",
                "description": "{{2.`الوصف`}}",
                "sku": "{{2.`رمز المنتج sku`}}",
                "cost_price": "{{2.`سعر التكلفة`}}",
                "sale_price": "{{2.`السعر المخفض`}}",
                "require_shipping": true,
                "weight": "{{2.`الوزن`}}",
                "quantity": 100
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "product_type": {
                            "mode": "chose",
                            "label": "product"
                        },
                        "require_shipping": {
                            "mode": "chose"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "salla2"
                            },
                            "label": "اتصال سلة"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:salla2,salla",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "name",
                        "type": "text",
                        "label": "Product Name",
                        "required": true
                    },
                    {
                        "name": "price",
                        "type": "uinteger",
                        "label": "Price",
                        "required": true
                    },
                    {
                        "name": "product_type",
                        "type": "select",
                        "label": "Product Type",
                        "required": true
                    },
                    {
                        "name": "description",
                        "type": "text",
                        "label": "Description"
                    },
                    {
                        "name": "sku",
                        "type": "text",
                        "label": "SKU"
                    },
                    {
                        "name": "cost_price",
                        "type": "uinteger",
                        "label": "Cost Price"
                    },
                    {
                        "name": "sale_price",
                        "type": "uinteger",
                        "label": "Sale Price"
                    },
                    {
                        "name": "require_shipping",
                        "type": "boolean",
                        "label": "Require Shipping"
                    },
                    {
                        "name": "weight",
                        "type": "uinteger",
                        "label": "Weight"
                    },
                    {
                        "name": "quantity",
                        "type": "uinteger",
                        "label": "Quantity"
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu2.make.com",
        "notes": [
            {
                "content": "سيناريو إضافة منتجات جديدة في سلة\n\nالتدفق:\n1. Webhook يستقبل البيانات من التطبيق\n2. Iterator يفرز المنتجات\n3. Salla ينشئ كل منتج\n\nالحقول:\n- أسم المنتج = اسم المنتج\n- سعر المنتج = السعر\n- الوصف = وصف المنتج\n- رمز المنتج sku = SKU\n- سعر التكلفة = التكلفة\n- الوزن = الوزن بالكيلو"
            }
        ]
    }
}
