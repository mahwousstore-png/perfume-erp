{
    "name": "Mahwous - تحديث أسعار سلة",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": null,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "استقبال تحديثات الأسعار"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    },
                    {
                        "name": "maxResults",
                        "type": "number",
                        "label": "Maximum number of results"
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": {
                "array": "{{1.data}}"
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {},
                "parameters": []
            }
        },
        {
            "id": 3,
            "module": "salla:UpdateProduct",
            "version": 1,
            "parameters": {
                "__IMTCONN__": null
            },
            "mapper": {
                "id": "{{2.`No.`}}",
                "price": "{{2.`سعر المنتج`}}",
                "cost_price": "{{2.`سعر التكلفة`}}",
                "sale_price": "{{2.`السعر المخفض`}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "id": {
                            "mode": "edit"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "salla2"
                            },
                            "label": "اتصال سلة"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:salla2,salla",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "id",
                        "type": "select",
                        "label": "Select Product",
                        "required": true
                    },
                    {
                        "name": "price",
                        "type": "uinteger",
                        "label": "The New price of The product."
                    },
                    {
                        "name": "cost_price",
                        "type": "uinteger",
                        "label": "The New cost of The New price of The product."
                    },
                    {
                        "name": "sale_price",
                        "type": "uinteger",
                        "label": "The New sale price of The product."
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "eu2.make.com",
        "notes": [
            {
                "content": "سيناريو تحديث أسعار المنتجات في سلة\n\nالتدفق:\n1. Webhook يستقبل البيانات من التطبيق\n2. Iterator يفرز المنتجات\n3. Salla يحدث كل منتج\n\nالحقول:\n- No. = معرف المنتج\n- سعر المنتج = السعر الجديد\n- سعر التكلفة = التكلفة\n- السعر المخفض = سعر البيع"
            }
        ]
    }
}
